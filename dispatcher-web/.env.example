# NagarIQ Dispatcher Web - Environment Configuration
# For Local Development: (defaults to http://127.0.0.1:8000 automatically)
# VITE_API_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000

# For Vercel Production Deployment:
# Set these in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://your-nagariq-backend.onrender.com
# VITE_WS_URL=wss://your-nagariq-backend.onrender.com
# VITE_CESIUM_TOKEN=your_cesium_ion_token_here (optional, for 3D buildings)
